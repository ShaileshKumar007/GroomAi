# ==============================================================================
# Groom.ai — Root .gitignore
# Covers Java/Spring Boot (backend), React Native/Expo (mobile), IDEs, OS, & secrets
# ==============================================================================

# ------------------------------------------------------------------------------
# Environment Variables & Secrets (CRITICAL: Never commit real credentials)
# ------------------------------------------------------------------------------
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example
!.env.sample

# Key and certificate files
*.pem
*.key
*.p12
*.jks
*.keystore

# ------------------------------------------------------------------------------
# Local Toolchain (Standalone portable tools)
# ------------------------------------------------------------------------------
.tools/

# ------------------------------------------------------------------------------
# Backend: Java & Maven (Spring Boot)
# ------------------------------------------------------------------------------
target/
*.class
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Maven local repository / logs
.m2/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# ------------------------------------------------------------------------------
# Mobile: Node.js, npm, Expo, React Native
# ------------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*

# Expo
.expo/
dist/
web-build/

# React Native / Metro / Watchman
.metro/
.watchmanconfig

# Native build artifacts (if prebuild is ever executed)
# Note: managed Expo workflow; native folders are generated if prebuilding
android/
ios/

# ------------------------------------------------------------------------------
# Testing & Code Coverage
# ------------------------------------------------------------------------------
coverage/
*.lcov
.nyc_output
test-results/

# ------------------------------------------------------------------------------
# Logs & Databases
# ------------------------------------------------------------------------------
*.log
*.log.*
logs/
*.sqlite
*.sqlite3
*.db

# ------------------------------------------------------------------------------
# IDEs & Developer Tooling
# ------------------------------------------------------------------------------
# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
out/

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# Eclipse / STS
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache

# NetBeans
nbproject/private/
build/
nbbuild/
dist/
nbdist/
.nb-gradle/

# ------------------------------------------------------------------------------
# Operating System Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
