# ==============================================================================
# Groom.ai — Environment Configuration Template (.env.example)
# Copy this file to .env for local development. Never commit real credentials!
# ==============================================================================

# ------------------------------------------------------------------------------
# Spring Boot Server Configuration
# ------------------------------------------------------------------------------
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# ------------------------------------------------------------------------------
# PostgreSQL Database (Phase 0+)
# ------------------------------------------------------------------------------
DB_URL=jdbc:postgresql://localhost:5432/groomai
DB_USERNAME=postgres
DB_PASSWORD=replace_with_secure_local_password
DB_POOL_SIZE=10

# ------------------------------------------------------------------------------
# JWT Authentication & Tokens (Phase 1+)
# ------------------------------------------------------------------------------
# Secret key used for signing HMAC-SHA256 JWT access tokens (min 256 bits / 32 bytes)
JWT_SECRET=replace_with_a_secure_random_base64_secret_key_at_least_256_bits
# Access token validity in milliseconds (default: 15 minutes = 900000 ms)
JWT_EXPIRATION_MS=900000
# Refresh token validity in milliseconds (default: 30 days = 2592000000 ms)
JWT_REFRESH_EXPIRATION_MS=2592000000

# ------------------------------------------------------------------------------
# Cloud Object Storage (S3-Compatible) (Phase 2+)
# ------------------------------------------------------------------------------
STORAGE_BUCKET=groomai-photos-dev
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=replace_with_storage_access_key
STORAGE_SECRET_KEY=replace_with_storage_secret_key

# ------------------------------------------------------------------------------
# Multimodal AI Provider (Phase 3+)
# ------------------------------------------------------------------------------
AI_PROVIDER_API_KEY=replace_with_ai_provider_api_key

# ------------------------------------------------------------------------------
# Transactional Email Gateway (Phase 5+)
# ------------------------------------------------------------------------------
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@groom.ai
