{
  "expo": {
    "name": "Groom.ai",
    "slug": "groomai",
    "version": "1.0.0",
    "orientation": "portrait",
    "platforms": [
      "ios",
      "android"
    ],
    "scheme": "groomai",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.groomai.app"
    },
    "android": {
      "package": "com.groomai.app",
      "adaptiveIcon": {
        "backgroundColor": "#0F172A"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to catalog clothes in your digital wardrobe.",
          "cameraPermission": "The app uses your camera to photograph clothing items for your digital wardrobe."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
